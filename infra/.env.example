# CAIOS environment template — copy to .env and fill in.
# RULES (CAIOS-MASTER-001 §19): never commit real values; separate dev/staging/prod;
# frontend never receives any of these.

# ── Runtime ──────────────────────────────────────────────────────────────
CAIOS_ENV=development                      # development | staging | production

# ── Database (Supabase in staging/prod; local Postgres in dev) ───────────
# Staging/production: use the Supabase *pooler* connection string (port 6543)
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://caios:caios_local_dev@db:5432/caios

# ── Auth (Supabase) ──────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCE=authenticated

# ── Model adapter (DeepSeek — initial provider, replaceable) ─────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Embedding adapter (independent of the LLM — ADR-012) ─────────────────
# Empty = deterministic dev embedder. Point at any OpenAI-compatible or TEI/Ollama endpoint, e.g.:
# EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings        (Ollama)
# EMBEDDING_MODEL=bge-m3
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=

# ── Storage adapter (Z1 S3-compatible; R2 for backups) ───────────────────
STORAGE_ENDPOINT=https://<z1-s3-endpoint>
STORAGE_BUCKET=caios-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=za-region

# ── Job runner (cron-job.org → /jobs/run; GH Actions → /maintenance/tick) ─
JOB_RUN_SECRET=change-me-generate-a-long-random-string
JOB_BATCH_SIZE=5
JOB_TIME_BUDGET_SECONDS=25
JOB_MAX_ATTEMPTS=3

# ── Knowledge & documents (Phase 2) ──────────────────────────────────────
# Safe defaults; only override for smaller free-tier DB budgets (blueprint §9).
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_EMBED_BATCH=32
KNOWLEDGE_TOP_K=6
KNOWLEDGE_MAX_UPLOAD_MB=20

# ── AI answering (Phase 3) ───────────────────────────────────────────────
# Model calls need DEEPSEEK_API_KEY (above); retrieval works without one.
AI_ANSWER_TEMPERATURE=0.2
AI_MAX_ANSWER_TOKENS=1024

# ── Resend (transactional email — Phase 4+) ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=CAIOS <noreply@yourdomain.co.za>

# ── GitHub Actions secrets (set in repo settings, not here) ──────────────
# SUPABASE_DB_URL      = direct (non-pooler) connection string for pg_dump
# BACKUP_S3_ENDPOINT   = R2 endpoint https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET     = caios-backups
# BACKUP_S3_ACCESS_KEY / BACKUP_S3_SECRET_KEY
# BACKUP_ENCRYPTION_KEY = strong passphrase for age/gpg encryption
# CAIOS_MAINTENANCE_URL = https://caios-api.onrender.com
# CAIOS_MAINTENANCE_SECRET = same value as JOB_RUN_SECRET
